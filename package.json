{
  "name": "9pay-integrate",
  "version": "2.0.0",
  "description": "Complete 9Pay payment gateway integration for Node.js and Next.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhat251/9pay-integrate.git"
  },
  "bugs": {
    "url": "https://github.com/nhat251/9pay-integrate/issues"
  },
  "homepage": "https://github.com/nhat251/9pay-integrate#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/config": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@types/node": "^20.0.0",
    "next": ">=14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "9pay",
    "payment",
    "payment-gateway",
    "vietnam",
    "nextjs",
    "typescript"
  ],
  "license": "MIT"
}
